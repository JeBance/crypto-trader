# ===========================================
# Crypto Trader Configuration Template
# ===========================================
# Скопируйте этот файл в .env и заполните значениями

# -------------------------------------------
# Приложение
# -------------------------------------------
APP_ENV=development
APP_DEBUG=true
APP_LOG_LEVEL=INFO

# -------------------------------------------
# Сервер
# -------------------------------------------
HOST=0.0.0.0
PORT=8000

# -------------------------------------------
# База данных
# -------------------------------------------
DATABASE_URL=sqlite+aiosqlite:///./data/crypto_trader.db

# -------------------------------------------
# Безопасность
# -------------------------------------------
# Сгенерируйте ключ: openssl rand -hex 32
API_KEY=your-secret-api-key-change-in-production
SECRET_KEY=your-secret-key-change-in-production

# -------------------------------------------
# Binance API (получите на https://www.binance.com/en/my/settings/api-management)
# -------------------------------------------
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# -------------------------------------------
# Bybit API (получите на https://testnet.bybit.com/app/user/api-management)
# -------------------------------------------
BYBIT_API_KEY=
BYBIT_API_SECRET=
BYBIT_TESTNET=true

# -------------------------------------------
# OKX API (получите на https://www.okx.com/account/my-api)
# -------------------------------------------
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
OKX_TESTNET=true

# -------------------------------------------
# Telegram Bot (получите у @BotFather)
# -------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# -------------------------------------------
# Торговые настройки
# -------------------------------------------
TRADING_MODE=paper
# paper - демо торговля
# live - реальная торговля

# -------------------------------------------
# Риск-менеджмент
# -------------------------------------------
MAX_POSITION_SIZE_PERCENT=10
# Максимальный размер позиции в % от депозита

STOP_LOSS_PERCENT=2
# Стоп-лосс в %

TAKE_PROFIT_PERCENT=4
# Тейк-профит в %

DAILY_LOSS_LIMIT_PERCENT=5
# Лимит дневного убытка в %
